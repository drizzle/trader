# --- Alpaca accounts ---
# Each configured account in config.yaml uses env_prefix + _ALPACA_*.
# The dashboard should not load this file. Trader/deploy subprocesses do.
PAPER_ALPACA_API_KEY=your_paper_key_here
PAPER_ALPACA_SECRET_KEY=your_paper_secret_here
PAPER_ALPACA_LIVE=false

LIVE_ALPACA_API_KEY=your_live_key_here
LIVE_ALPACA_SECRET_KEY=your_live_secret_here
LIVE_ALPACA_LIVE=true

# IRA accounts must not run crypto strategies. See config.yaml account type: ira.
ROTH_IRA_ALPACA_API_KEY=your_roth_ira_key_here
ROTH_IRA_ALPACA_SECRET_KEY=your_roth_ira_secret_here
ROTH_IRA_ALPACA_LIVE=true

# Backward-compatible single-account fallback when config.yaml has no accounts.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_LIVE=false

# --- DeepSeek LLM (for the Advisors tab + Market Summary) ---
# Sign up at https://platform.deepseek.com, then create a key at
# https://platform.deepseek.com/api_keys
# IMPORTANT: never paste this into chat, code, or commit messages.
# After setting it here, lock the file:  chmod 600 /opt/trader/.env
DEEPSEEK_API_KEY=

# --- Telegram alerts (optional) ---
# Create a bot via @BotFather, then send it a message and get your chat ID
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO

# --- Paths ---
# Where SQLite + logs live. Defaults to ./data inside the project dir.
DATA_DIR=./data
