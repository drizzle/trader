# Dashboard-only environment.
# Copy to /opt/trader/dashboard.env, edit, then:
#   sudo chown trader:trader /opt/trader/dashboard.env
#   sudo chmod 600 /opt/trader/dashboard.env
#   sudo systemctl restart trader-dashboard

# Required when DASHBOARD_READ_ONLY=false.
DASHBOARD_PASSWORD=change-me-long-random-password
DASHBOARD_USERNAME=trader
DASHBOARD_REQUIRE_AUTH=true
DASHBOARD_SESSION_SECONDS=300

# Set false to allow deploy/risk/kill-switch writes from the dashboard.
DASHBOARD_READ_ONLY=true

# Keep false unless you intentionally accept putting Alpaca keys in this
# dashboard-only env file. With the secure default, the dashboard reads local
# SQLite/config state and the trader process remains the only Alpaca key holder.
DASHBOARD_ENABLE_BROKER_READS=false

# Optional LLM features for Advisor/Summary.
DEEPSEEK_API_KEY=

# Keep this aligned with the trader service data dir.
DATA_DIR=./data
LOG_LEVEL=INFO
