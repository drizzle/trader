[Unit]
Description=Trader dashboard (FastAPI, localhost-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trader
# Keep Alpaca trading keys out of the dashboard process by default. Put only
# dashboard-specific settings in this file, e.g. DASHBOARD_PASSWORD and
# DASHBOARD_READ_ONLY=false.
EnvironmentFile=-/opt/trader/dashboard.env
Environment=TRADER_LOAD_DOTENV=false
ExecStart=/opt/trader/.venv/bin/python -m trader dashboard --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
# The dashboard has a narrow sudoers grant for restarting only the trader
# service. NoNewPrivileges would block that grant and make dashboard deploys
# fail even when /etc/sudoers.d/trader-restart is installed.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trader/data /opt/trader/config.yaml
PrivateTmp=true

[Install]
WantedBy=multi-user.target
